# BrewLite – example names only; do not store real credentials.
# ROOT FILE DOCUMENTS ENVIRONMENT ONLY.
# Place frontend variables in apps/web/.env.local and backend vars in apps/api/.env
# after checking which names the existing source actually reads.

# FRONTEND Next.js (used by proposed apps/web/src/app/page.tsx)
NEXT_PUBLIC_API_URL=http://localhost:3001

# BACKEND NestJS – select PORT or API_PORT based on apps/api/src/main.ts
PORT=3001
# API_PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# DATABASE – examples pending verification of ConfigModule/ORM
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/brewlite
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=brewlite
# Used by docker-compose.yml for local PostgreSQL only.
DB_PASSWORD=replace_locally
# DB_NAME=brewlite

# AUTH – only if JWT is implemented in Sprint 2
# JWT_SECRET=replace_with_secret_in_local_env

# MOCK PAYMENT – add only if the payment module reads these names
# MOCK_PAYMENT_MODE=success
